# ==================================================
# OS / editor
# ==================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ==================================================
# Jupyter / Python cache
# ==================================================
.ipynb_checkpoints/
pipeline/.jupyter/
*.log
*.nbconvert.ipynb
__pycache__/
*.pyc

# ==================================================
# Local virtual environments (do NOT version)
# ==================================================
.venv/
venv/
env/
Scripts/
Lib/
Include/
share/
pyvenv.cfg
conda-meta/

# ==================================================
# Temporary / backup files
# ==================================================
*.tmp
*.bak
.tmp_*/
.tmp_*.py
tmp/
tmp_*/

# Local editorial/document-processing workspace
text/
tools/

# Superseded integrated notebook snapshots; the canonical notebook is
# pipeline/pipeline_heatflow_vs_tectonics.ipynb.
pipeline/*_integrated_*.ipynb

# ==================================================
# Scientific input data
# ==================================================

# Ignore ONLY datasets hosted in Zenodo
data/raw/earthquakes/**
data/raw/gravity/**

# Ignore processed data
data/processed/**

# ==================================================
# IGNORE upload artifacts (CRITICAL)
# ==================================================
data/raw/zenodo_upload/**
data/raw/*.zip

# ==================================================
# Large scientific formats (outside curated inputs)
# ==================================================
*.xlsx
*.xls
*.nc
*.grd
*.tif
*.tiff
*.qix
*.aux.xml

*.parquet
*.gpkg

# ==================================================
# Shapefiles (ONLY if outside curated raw folders)
# ==================================================
*.shp
*.shx
*.dbf
*.prj
*.cpg

# ==================================================
# Generated outputs (NOT versioned — in Zenodo)
# ==================================================
public_release/**
public_release_package/**
public/**

# ==================================================
# Safety: allow curated raw datasets (small/essential)
# ==================================================
!data/raw/
!data/raw/IHFC/**
!data/raw/GEM/**
!data/raw/PB2002/**
!data/raw/NaturalEarth/**
!data/raw/strain/**
!data/raw/readme_raw.md
!data/raw/README_context_datasets.md

# Curated contextual inputs added for the revised analysis.
!data/raw/CRUST1/
data/raw/CRUST1/**
!data/raw/CRUST1/crust1_moho.xyz

!data/raw/ocean_age/
data/raw/ocean_age/**
!data/raw/ocean_age/age.3.2.nc.bz2

!data/raw/plate_boundaries_typed/
data/raw/plate_boundaries_typed/**
!data/raw/plate_boundaries_typed/utig_noaa_plate_boundaries.geojson
