# ==================================================
# OS / editor
# ==================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ==================================================
# Jupyter / Python cache
# ==================================================
.ipynb_checkpoints/
*.log
*.nbconvert.ipynb
__pycache__/
*.pyc

# ==================================================
# Local virtual environments (do NOT version)
# ==================================================
.venv/
venv/
env/
Scripts/
Lib/
Include/
share/
pyvenv.cfg
conda-meta/

# ==================================================
# Temporary / backup files
# ==================================================
*.tmp
*.bak

# ==================================================
# Scientific input data
# ==================================================

# Ignore ONLY datasets hosted in Zenodo
data/raw/earthquakes/**
data/raw/gravity/**

# Ignore processed data
data/processed/**

# ==================================================
# IGNORE upload artifacts (CRITICAL)
# ==================================================
data/raw/zenodo_upload/**
data/raw/*.zip

# ==================================================
# Large scientific formats (outside curated inputs)
# ==================================================
*.xlsx
*.xls
*.nc
*.grd
*.tif
*.tiff
*.qix
*.aux.xml

*.parquet
*.gpkg

# ==================================================
# Shapefiles (ONLY if outside curated raw folders)
# ==================================================
*.shp
*.shx
*.dbf
*.prj
*.cpg

# ==================================================
# Generated outputs (NOT versioned — in Zenodo)
# ==================================================
public_release/**
public_release_package/**
public/**

# ==================================================
# Safety: allow curated raw datasets (small/essential)
# ==================================================
!data/raw/
!data/raw/IHFC/**
!data/raw/GEM/**
!data/raw/PB2002/**
!data/raw/NaturalEarth/**
!data/raw/strain/**
!data/raw/readme_raw.md